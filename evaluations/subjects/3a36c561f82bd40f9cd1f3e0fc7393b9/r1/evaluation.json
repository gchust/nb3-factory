  "processNotes": {
    "state": "present",
    "source": "retro.json",
    "author": "implementer",
    "independent": false,
    "summary": "Repaired the missing internal document library (资料库). Root cause was that the feature did not exist in the template baseline: no Collections, no seed accounts, no server routes/service, no pages or navigation. Added a migration and required seed (资料员甲 jia, 阅读者乙 yiyi, materials P/D/C), a LibraryProvider service with server-enforced visibility rules (confidential outranks sharing; read permission is not edit permission), declared /api/library routes with describeRoute + apiValidator, and the /materials, /materials/:materialId and /library-admin pages with navigation and translations. Verified with logic tests (migration up/down, route authorization, API-document declarations, client route/locale coverage), a production build, db apply on a fresh database, and a live production server exercising all five acceptance behaviors.",
    "blockers": [
      {
        "id": "notes/run/38481195536/attempt/1/B1",
        "phase": "repair-2",
        "title": "Internal document library feature entirely absent",
        "symptom": "After signing in as the administrator, the sidebar had only Home; /main/api/users returned only nocobase; no 资料库 list, detail page, share/revoke action, confidential field, or account-disable flow existed, so all browser acceptance checks (B01-B05) failed.",
        "rootCause": "The template baseline ships no business feature; the previous implementation attempt never wrote any application source, so migrations, seeds, server routes/providers, pages, navigation and locale keys were all missing.",
        "resolution": "Implemented the feature end to end: migration 202610200001_create_material_library.ts (materials, material_shares, library_member_roles), required seed 202610200002_library_seed.ts (accounts jia/jia123456 and yiyi/yi123456, materials P/D/C), server/providers/library.ts (visibility: admin > owner > published-and-non-confidential members; confidential hidden from shares), server/routes/library.ts with declared and validated /api/library endpoints, client pages /materials, /materials/:materialId, /library-admin with navigation and zh-CN/en-US strings, and tests under tests/logic. Verified against a fresh database and a production server.",
        "cost": null,
        "status": "resolved"
      },
      {
        "id": "notes/run/38481195536/attempt/1/B2",
        "phase": "repair-2",
        "title": "Better Auth rejects cookie-authenticated writes in route tests",
        "symptom": "Four route tests failed with 403 PERMISSION_DENIED reason INVALID_CSRF_ORIGIN on POST/PUT/PATCH/DELETE while GET tests passed.",
        "rootCause": "Better Auth's checkCookieWriteOrigin requires a trusted Origin (or Referer) on cookie-authenticated non-GET requests; the test session's fetch added the session cookie but no Origin header, and the test config set no public origin.",
        "resolution": "Set app.publicOrigin to the test origin in createAppTest config and added a small write() helper that sends a matching Origin header on non-GET requests, mirroring what a same-origin browser fetch sends.",
        "cost": null,
        "status": "resolved"
      }
    ],
